#!/usr/bin/env bash
# ==============================================================================
# AgyFreeAgent - Profile Provisioner
# Configures multi-account Google Antigravity CLI instances (agy1..agyn)
# using Linux user-space filesystem namespaces (bwrap).
# ==============================================================================

set -euo pipefail

BIN_DIR="${HOME}/.local/bin"
PROFILES_BASE="${HOME}/.gemini-profiles"
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "${SCRIPT_PATH}")"
TEMPLATES_DIR="$(cd "${SCRIPT_DIR}/../templates" 2>/dev/null && pwd)"

mkdir -p "${BIN_DIR}"
mkdir -p "${HOME}/workspaces"

usage() {
  echo "Usage: agy-setup <profile_number> (e.g. agy-setup 2, agy-setup 3)"
  echo ""
  echo "Active agy profiles:"
  ls -la "${BIN_DIR}"/agy* 2>/dev/null || echo "No profiles configured yet."
  exit 1
}

if [[ $# -lt 1 ]]; then
  usage
fi

PROFILE_INDEX="$1"

# Profile 1: Primary default profile
if [[ "${PROFILE_INDEX}" == "1" ]]; then
  echo "[+] Setting up agy1 (Primary Profile -> default agy)..."
  if ! command -v agy &>/dev/null; then
    echo "[!] Warning: 'agy' command not found in PATH. Ensure Antigravity CLI is installed in ~/.local/bin."
  fi
  ln -sf "$(command -v agy || echo "${BIN_DIR}/agy")" "${BIN_DIR}/agy1"

  # Seed YOLO settings.json into primary profile (~/.gemini/antigravity-cli/settings.json)
  PRIMARY_DIR="${HOME}/.gemini/antigravity-cli"
  mkdir -p "${PRIMARY_DIR}"
  PRIMARY_SETTINGS="${PRIMARY_DIR}/settings.json"
  if [[ ! -f "${PRIMARY_SETTINGS}" ]]; then
    echo "[+] Seeding autonomous YOLO permissions into ${PRIMARY_SETTINGS}..."
    if [[ -f "${TEMPLATES_DIR}/settings.json" ]]; then
      sed "s|\$HOME|${HOME}|g" "${TEMPLATES_DIR}/settings.json" > "${PRIMARY_SETTINGS}"
    fi
  fi

  echo "[✓] agy1 successfully linked to default agy with auto-approval YOLO mode."
  echo "Run 'agy1' to start your primary session."
  exit 0
fi

# Profiles 2..N: Bubblewrap isolated profiles
PROFILE_DIR="${PROFILES_BASE}/acc${PROFILE_INDEX}/antigravity-cli"
WRAPPER_FILE="${BIN_DIR}/agy${PROFILE_INDEX}"

if ! command -v bwrap &>/dev/null; then
  echo "[!] Error: 'bwrap' (bubblewrap) is required for multi-profile isolation."
  echo "    Install it via: sudo apt install -y bubblewrap (Debian/Ubuntu) or dnf install bubblewrap (Fedora)"
  exit 1
fi

echo "[+] Creating isolated profile directory: ${PROFILE_DIR}"
mkdir -p "${PROFILE_DIR}"
mkdir -p "${PROFILES_BASE}/acc${PROFILE_INDEX}/.gemini"
ln -sfn "${PROFILE_DIR}" "${PROFILES_BASE}/acc${PROFILE_INDEX}/.gemini/antigravity-cli"

echo "[+] Generating wrapper launcher: ${WRAPPER_FILE}"
cat << EOF > "${WRAPPER_FILE}"
#!/usr/bin/env bash
# Auto-generated by AgyFreeAgent (Profile ${PROFILE_INDEX})
PROFILE_DIR="\$HOME/.gemini-profiles/acc${PROFILE_INDEX}/antigravity-cli"
mkdir -p "\$PROFILE_DIR"

AGY_BIN="\$(command -v agy || echo "\$HOME/.local/bin/agy")"

exec bwrap \\
  --dev-bind / / \\
  --bind "\$PROFILE_DIR" "\$HOME/.gemini/antigravity-cli" \\
  "\$AGY_BIN" "\$@"
EOF

chmod +x "${WRAPPER_FILE}"

# Seed settings.json if not present
SETTINGS_FILE="${PROFILE_DIR}/settings.json"
if [[ ! -f "${SETTINGS_FILE}" ]]; then
  echo "[+] Seeding autonomous permissions into ${SETTINGS_FILE}..."
  if [[ -f "${TEMPLATES_DIR}/settings.json" ]]; then
    # Dynamically inject current user's home into template
    sed "s|\$HOME|${HOME}|g" "${TEMPLATES_DIR}/settings.json" > "${SETTINGS_FILE}"
  else
    cat << EOF > "${SETTINGS_FILE}"
{
  "allowNonWorkspaceAccess": true,
  "artifactReviewMode": "always-proceed",
  "enableTelemetry": false,
  "permissionPreset": "unrestricted",
  "permissions": {
    "allow": [
      "command(*)",
      "mcp(*)",
      "read_file(*)",
      "read_url(*)",
      "write_file(*)"
    ]
  },
  "sandboxMode": false,
  "toolPermission": "always-proceed",
  "trustedWorkspaces": [
    "/",
    "${HOME}",
    "${HOME}/workspaces"
  ]
}
EOF
  fi
fi

echo "[✓] Profile agy${PROFILE_INDEX} configured successfully!"
echo "Run 'agy${PROFILE_INDEX}' to authenticate your Google Account ${PROFILE_INDEX} and start your session."
