#!/usr/bin/env node

/**
 * AgyFreeAgent - Clean-Room Pre-Flight Shield
 * Scans git commits and files for secret leaks, private keys, and sensitive tokens.
 */

import fs from "fs";
import path from "path";
import { execSync } from "child_process";

const ANSI = {
  reset: "\x1b[0m",
  bold: "\x1b[1m",
  red: "\x1b[31m",
  green: "\x1b[32m",
  yellow: "\x1b[33m",
  cyan: "\x1b[36m",
};

const SENSITIVE_PATH_PATTERNS = [
  { pattern: /(^|\/)\.env(\.(?!example)[a-zA-Z0-9_\-]+)?$/i, reason: "Environment file containing credentials (.env)" },
  { pattern: /\.(pem|key|pkcs12|pfx|p12|jks)$/i, reason: "Cryptographic private key or certificate store" },
  { pattern: /(^|\/)id_(rsa|dsa|ecdsa|ed25519)(\.pub)?$/i, reason: "SSH keypair file" },
  { pattern: /(^|\/)credentials\.json$/i, reason: "Service credentials JSON" },
  { pattern: /(^|\/)service-account(-[a-zA-Z0-9_\-]+)?\.json$/i, reason: "Service account key JSON" },
];

const SECRET_RULES = [
  { name: "Google API Key", regex: /\bAIza[0-9A-Za-z\-_]{35}\b/, severity: "HIGH" },
  { name: "GitHub Personal Token", regex: /\b(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9_]{36,255}\b/, severity: "HIGH" },
  { name: "Private RSA/OpenSSH Key", regex: /-----BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----/, severity: "CRITICAL" },
  { name: "Generic Secret String", regex: /(api_key|apikey|secret_key|private_key)\s*[:=]\s*["'][a-zA-Z0-9_\-]{20,}["']/i, severity: "MEDIUM" }
];

function checkStaged() {
  console.log(`${ANSI.cyan}[*] AgyFreeAgent Clean-Room Guard: Scanning staged files...${ANSI.reset}`);

  let stagedFiles = [];
  try {
    const raw = execSync("git diff --cached --name-only", { encoding: "utf8" }).trim();
    if (raw) stagedFiles = raw.split("\n").filter(Boolean);
  } catch {
    console.log(`${ANSI.green}[✓] Not a git repository or no staged files found.${ANSI.reset}`);
    return;
  }

  if (stagedFiles.length === 0) {
    console.log(`${ANSI.green}[✓] No staged files to check.${ANSI.reset}`);
    return;
  }

  let violations = [];

  // Check file paths
  for (const file of stagedFiles) {
    for (const rule of SENSITIVE_PATH_PATTERNS) {
      if (rule.pattern.test(file)) {
        violations.push({ file, type: "Sensitive Path", reason: rule.reason });
      }
    }
  }

  // Check diff contents
  for (const file of stagedFiles) {
    if (!fs.existsSync(file)) continue;
    try {
      const diff = execSync(`git diff --cached -- "${file}"`, { encoding: "utf8" });
      const addedLines = diff.split("\n").filter(line => line.startsWith("+") && !line.startsWith("+++"));

      for (const line of addedLines) {
        for (const rule of SECRET_RULES) {
          if (rule.regex.test(line)) {
            violations.push({ file, type: `Secret Pattern (${rule.name})`, snippet: line.trim() });
          }
        }
      }
    } catch {}
  }

  if (violations.length > 0) {
    console.error(`\n${ANSI.red}${ANSI.bold}[!] CLEAN-ROOM PRE-FLIGHT CHECK FAILED:${ANSI.reset}`);
    for (const v of violations) {
      console.error(`  - ${ANSI.red}${v.file}${ANSI.reset}: ${v.type} ${v.reason || v.snippet || ""}`);
    }
    console.error(`\n${ANSI.yellow}Commit blocked. Remove sensitive data or secrets before pushing.${ANSI.reset}\n`);
    process.exit(1);
  }

  console.log(`${ANSI.green}[✓] Clean-room audit passed: Zero sensitive files or tokens detected.${ANSI.reset}\n`);
}

checkStaged();
