# ==============================================================================
# AgyFreeAgent - Environment Configuration Template
# "No API keys. No credit cards. Just your Google accounts."
#
# 🚀 PRO FAST-PATH:
# Fill in your variables here BEFORE running the installer:
#   cp .env.example .env
#   nano .env  (or use your editor: code .env / cursor .env)
#
# When you run ./scripts/install.sh, it will automatically consume all values
# from .env—skipping interactive prompts and provisioning everything silently!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DEVELOPER & GIT IDENTITY (Required for autonomous commits)
# ------------------------------------------------------------------------------
# Your author name and email attached to git commits made by the agent.
#
# 🔗 Where to find your GitHub profile name: https://github.com/settings/profile
# 🔗 Where to find your verified GitHub email: https://github.com/settings/emails
GIT_USER_NAME=""
GIT_USER_EMAIL=""

# ------------------------------------------------------------------------------
# 2. GITHUB AUTHENTICATION & SSH
# ------------------------------------------------------------------------------
# Automatically generate a high-security Ed25519 SSH key if none exists? (true/false)
# 🔗 GitHub SSH key settings: https://github.com/settings/keys
# 🔗 Official GitHub SSH guide: https://docs.github.com/en/authentication/connecting-to-github-with-ssh/adding-a-new-ssh-key-to-your-github-account
AUTO_GENERATE_SSH="true"

# Optional: GitHub Personal Access Token (PAT) with 'repo' scope.
# If provided, install.sh will automatically authorize GitHub CLI (`gh auth login`)
# so your agent can clone, push, and create repositories without password prompts.
#
# 🔗 1-Click Direct Token Generator (scopes pre-selected):
#    https://github.com/settings/tokens/new?scopes=repo,read:org,admin:public_key&description=AgyFreeAgent
# 🔗 Official GitHub PAT guide:
#    https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens
#
# Steps: Open the 1-click link above -> click 'Generate token' at bottom -> copy token (starts with 'ghp_')
GITHUB_TOKEN=""

# ------------------------------------------------------------------------------
# 3. AUTONOMOUS YOLO PERMISSIONS & SUDO
# ------------------------------------------------------------------------------
# Automatically grant passwordless sudo (/etc/sudoers.d/agy-agent)? (true/false)
# Highly recommended: allows agents to install packages (apt/dnf), restart daemons,
# and manage Docker containers in the background without hanging on passwords.
ENABLE_SUDO_ALL="true"

# ------------------------------------------------------------------------------
# 4. TELEGRAM NOTIFICATIONS (Mobile briefings & CI alerts)
# ------------------------------------------------------------------------------
# Receive real-time alerts on your phone when agents finish tasks or hit errors.
#
# [TELEGRAM_BOT_TOKEN]
# 🔗 Direct BotFather link: https://t.me/BotFather
# 🔗 Official Bot Tutorial: https://core.telegram.org/bots/tutorial#obtain-your-bot-token
# Steps:
#   1. Open @BotFather on Telegram (link above) and tap Start.
#   2. Send message: /newbot
#   3. Enter a display name (e.g. My Agy Free Agent) and a username ending in 'bot' (e.g. my_agy_agent_bot).
#   4. BotFather will reply with your HTTP API token (e.g. 123456789:ABCdefGHIjklMNOpqrSTUvwxYZ).
TELEGRAM_BOT_TOKEN=""

# [TELEGRAM_CHAT_ID]
# 🔗 Direct UserInfoBot link: https://t.me/userinfobot
# 🔗 Alternative RawDataBot:  https://t.me/raw_data_bot
# Steps:
#   1. Open @userinfobot on Telegram (link above) and tap Start.
#   2. The bot will instantly reply with your numeric ID: `Id: 123456789`.
#   3. Copy that number and paste it below.
#   (Note: Remember to also send at least one "/start" message to your newly created bot!)
TELEGRAM_CHAT_ID=""

# ------------------------------------------------------------------------------
# 5. GOOGLE ANTIGRAVITY MULTI-PROFILE SWARM
# ------------------------------------------------------------------------------
# Number of isolated Google accounts to provision (e.g. 1 = agy1, 2 = agy1 & agy2, 3 = agy1..agy3).
# Set to 2 or more to enable seamless cross-profile relay (unlimited 24/7 quota).
#
# 🔗 Google Antigravity official download: https://antigravity.google
# 🔗 Google accounts login / creation: https://accounts.google.com
AGY_PROFILES_COUNT="2"

# Automatically install @google/antigravity-cli via npm if missing? (true/false)
AUTO_INSTALL_AGY_NPM="true"

# ------------------------------------------------------------------------------
# 6. TAILSCALE REMOTE MESH ACCESS (Optional)
# ------------------------------------------------------------------------------
# One-time pre-authenticated Tailscale auth key to auto-join your secure mesh VPN.
#
# 🔗 Direct Key Generator: https://login.tailscale.com/admin/settings/keys
# 🔗 Official Auth Keys guide: https://tailscale.com/kb/1085/auth-keys
# Steps:
#   1. Open the Key Generator link above.
#   2. Click 'Generate auth key...'.
#   3. Check 'Reusable' (optional) and click 'Generate key'.
#   4. Copy the key (starts with 'tskey-auth-...') and paste below.
TAILSCALE_AUTHKEY=""
